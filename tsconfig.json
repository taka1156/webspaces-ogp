{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "jsx": "react-jsx",
        "jsxImportSource": "hono/jsx",
        "lib": [
            "ES2022",
            "DOM",
            "DOM.Iterable"
        ],
        "useDefineForClassFields": true,
        "strict": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "resolveJsonModule": true,
        "experimentalDecorators": true,
        "noEmit": true
    },
    "include": [
        "vite-env.d.ts",
        "src",
        "vite.config.lib.ts",
    ],
    "exclude": [
        "node_modules",
        "**/assets/**"
    ],
    "typeRoots": [
        "./node_modules/@types",
        "./src/types"
    ]
}
